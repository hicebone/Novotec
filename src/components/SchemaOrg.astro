---
interface Props {
  siteUrl?: string;
}

const { siteUrl = "https://hicebone.github.io/Novotec" } = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "ElectronicsRepairShop"],
      "@id": `${siteUrl}/#business`,
      "name": "Novotec Hermosillo",
      "alternateName": "Novotec Reparación de Computadoras",
      "url": `${siteUrl}/`,
      "logo": `${siteUrl}/imagenes/logo-optimized.png`,
      "image": [
        `${siteUrl}/imagenes/opt/reparacion-optimizada.webp`,
        `${siteUrl}/imagenes/logo-optimized.png`
      ],
      "description": "Reparación y mantenimiento de computadoras y laptops en Hermosillo, Sonora. Más de 25 años de experiencia. Optimización, eliminación de virus y soporte técnico.",
      "telephone": "+526625085372",
      "priceRange": "$$",
      "currenciesAccepted": "MXN",
      "paymentAccepted": "Efectivo, Transferencia, Tarjeta",
      "areaServed": {
        "@type": "City",
        "name": "Hermosillo"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Hermosillo",
        "addressRegion": "Sonora",
        "addressCountry": "MX"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "sameAs": [
        "https://facebook.com/elnovotech",
        "https://wa.me/526625085372"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de Reparación y Soporte Técnico de Cómputo",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Reparación de laptops en Hermosillo"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Reparación y mantenimiento de computadoras PC"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Solución a computadoras lentas y optimización"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Eliminación de virus y seguridad informática"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Instalación de Windows y software con respaldo"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Recuperación de archivos y datos"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Soporte técnico remoto"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Redes, WiFi y conectividad"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Software a tu medida"
            }
          }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Novotec Hermosillo",
      "description": "Reparación profesional de computadoras y laptops en Hermosillo, Sonora.",
      "inLanguage": "es-MX",
      "publisher": {
        "@id": `${siteUrl}/#business`
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo tarda la reparación de una computadora o laptop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El tiempo promedio de diagnóstico inicial es de 24 a 48 horas. Mantenimientos preventivos, limpiezas internas, formateos o cambio de disco duro a unidad de estado sólido (SSD) frecuentemente quedan listos en 24 a 48 horas una vez autorizado el presupuesto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se pierden mis archivos o fotos al reparar o formatear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. En Novotec realizamos un respaldo preventivo estricto de tus documentos, fotos y datos personales antes de realizar cualquier intervención en el sistema operativo o almacenamiento. Cuidamos tu privacidad y la integridad de tu información."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué puedo hacer si mi computadora o laptop está muy lenta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la gran mayoría de los casos no es necesario comprar un equipo nuevo: una actualización a disco de estado sólido (SSD) de alta velocidad, ampliación de memoria RAM y una limpieza profunda del inicio de Windows multiplican la rapidez de tu equipo con una inversión mucho menor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tipos y marcas de computadoras atienden en Hermosillo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atendemos laptops y computadoras de escritorio de todas las marcas del mercado: HP, Dell, Lenovo, ASUS, Acer, Apple Mac, así como computadoras armadas para oficina, diseño y computadoras gamer."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué situaciones aplica el soporte técnico remoto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El soporte remoto es una excelente alternativa para solucionar problemas de software, eliminación de publicidad molesta, configuración de impresoras, errores de programas o asesoría rápida sin que tengas que trasladar físicamente tu equipo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Ofrecen garantía en las reparaciones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Todos los trabajos efectuados y las refacciones instaladas cuentan con garantía por escrito en taller para tu entera tranquilidad y respaldo."
          }
        }
      ]
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
