---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const logoSrc = `${base}imagenes/logo-optimized.png`;
---

<header class="site-header" id="cabecera">
  <div class="container header-container">
    <!-- Logotipo y Marca Oficial Novotec Hermosillo -->
    <a href="#inicio" class="brand-link">
      <img
        src={logoSrc}
        alt=""
        class="brand-logo"
        width="160"
        height="69"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <div class="brand-text-block">
        <span class="brand-title">Novotec</span>
        <span class="brand-subtitle">Hermosillo · 25+ Años</span>
      </div>
    </a>

    <!-- Botón Menú Móvil Accesible -->
    <button
      type="button"
      class="nav-toggle"
      id="navToggle"
      aria-expanded="false"
      aria-controls="navMenu"
      aria-label="Abrir menú de navegación"
    >
      <span class="icon-open"><Icon name="menu" size={26} /></span>
      <span class="icon-close"><Icon name="close" size={26} /></span>
    </button>

    <!-- Navegación Principal -->
    <nav class="nav-shell" id="navShell" aria-label="Navegación principal">
      <ul class="nav-list" id="navMenu">
        <li><a class="nav-link" href="#inicio">Inicio</a></li>
        <li><a class="nav-link nav-link--highlight" href="#diagnostico">Diagnóstico</a></li>
        <li><a class="nav-link" href="#servicios">Servicios</a></li>
        <li><a class="nav-link" href="#proceso">Cómo Trabajamos</a></li>
        <li><a class="nav-link" href="#experiencia">Experiencia</a></li>
        <li><a class="nav-link" href="#faq">Preguntas</a></li>
        <li><a class="nav-link nav-link--contact" href="#contacto">Contacto</a></li>

        <!-- Accesos Directos de Taller en Cabecera -->
        <li class="nav-item-actions">
          <a
            class="header-phone-btn"
            href="tel:+526625085372"
            aria-label="Llamar directamente al taller Novotec al +52 662 508 5372"
          >
            <Icon name="phone" size={17} />
            <span class="phone-number">662 508 5372</span>
          </a>

          <a
            class="btn btn-whatsapp header-cta"
            href="https://wa.me/526625085372?text=Hola%20Novotec%2C%20quisiera%20cotizar%20un%20servicio%20técnico%20para%20mi%20computadora."
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp: Contactar a Novotec al +52 662 508 5372 (abre en nueva pestaña)"
          >
            <Icon name="whatsapp" size={18} />
            <span>WhatsApp</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: rgba(11, 15, 23, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-dark-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    border-radius: var(--radius-xs);
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 44px;
    max-width: 150px;
    object-fit: contain;
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .brand-subtitle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-copper-text-dark);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav-shell {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.85rem;
    font-size: 0.92rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-inverse-muted);
    text-decoration: none;
    border-radius: var(--radius-xs);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .nav-link--highlight {
    color: #38bdf8;
    font-weight: var(--font-weight-semibold);
  }

  .nav-link--contact {
    color: #ffffff;
    font-weight: var(--font-weight-semibold);
  }

  .nav-item-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-left: 0.75rem;
  }

  .header-phone-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-inverse);
    text-decoration: none;
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-xs);
    background-color: var(--color-dark-surface);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .header-phone-btn:hover {
    border-color: var(--color-copper);
    color: var(--color-copper);
    background-color: var(--color-dark-surface-raised);
  }

  .header-cta {
    min-height: 40px;
    padding: 0.45rem 1rem;
    font-size: 0.88rem;
    border-radius: var(--radius-xs);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-dark-border);
    color: #ffffff;
    background-color: var(--color-dark-surface);
    cursor: pointer;
  }

  .nav-toggle .icon-close {
    display: none;
  }

  @media (max-width: 1080px) {
    .phone-number {
      display: none;
    }
  }

  @media (max-width: 991px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-shell {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-dark-bg);
      border-bottom: 1px solid var(--color-dark-border);
      box-shadow: var(--shadow-lg);
      padding: 1.25rem 1.5rem;
      display: none;
    }

    .nav-shell.is-open {
      display: block;
    }

    .nav-toggle[aria-expanded="true"] .icon-open {
      display: none;
    }

    .nav-toggle[aria-expanded="true"] .icon-close {
      display: inline-block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .nav-link {
      padding: 0.75rem 1rem;
      width: 100%;
      font-size: 1rem;
    }

    .nav-item-actions {
      flex-direction: column;
      margin-left: 0;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-dark-border);
      gap: 0.75rem;
    }

    .header-phone-btn,
    .header-cta {
      width: 100%;
      justify-content: center;
    }

    .phone-number {
      display: inline;
    }
  }

  @media (max-width: 480px) {
    .brand-logo {
      height: 34px;
      max-width: 95px;
    }

    .brand-title {
      font-size: 1.05rem;
    }

    .brand-subtitle {
      font-size: 0.65rem;
    }
  }
</style>

<script>
  // Control accesible del menú móvil (NVDA, TalkBack y teclado)
  const toggleBtn = document.getElementById('navToggle');
  const navShell = document.getElementById('navShell');
  const navLinks = document.querySelectorAll('.nav-link, .header-cta, .header-phone-btn');

  if (toggleBtn && navShell) {
    const toggleMenu = (open?: boolean) => {
      const isExpanded = open !== undefined ? open : (toggleBtn.getAttribute('aria-expanded') === 'true');
      const newState = !isExpanded;
      toggleBtn.setAttribute('aria-expanded', String(newState));
      toggleBtn.setAttribute('aria-label', newState ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      navShell.classList.toggle('is-open', newState);
    };

    toggleBtn.addEventListener('click', () => toggleMenu());

    // Cerrar al presionar Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });

    // Cerrar al seleccionar un enlace
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (toggleBtn.getAttribute('aria-expanded') === 'true') {
          toggleMenu(false);
        }
      });
    });
  }
</script>
