---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const resolveAsset = (path: string) => {
  if (path.startsWith('http')) return path;
  const clean = path.startsWith('/') ? path.slice(1) : path;
  return `${base}${clean}`;
};

const services = [
  {
    id: "laptops",
    icon: "laptop",
    title: "Reparación de Laptops en Hermosillo",
    image: "/imagenes/opt/reparacion-optimizada.webp",
    alt: "Técnico especialista diagnosticando y reparando una laptop en taller Hermosillo",
    description: "Diagnóstico preciso para laptops que no encienden, pantallas rotas o negras, cambio de bisagras, teclado, batería, limpieza interna y cambio de pasta térmica en todas las marcas.",
    badge: "Servicio Frecuente",
    time: "24 a 48h",
    inclusions: ["Diagnóstico inicial en taller", "Presupuesto cerrado sin sorpresas", "Garantía por escrito"],
    phone: "526625085372",
    waMsg: "Hola Novotec, quisiera cotizar la reparación de una laptop en Hermosillo."
  },
  {
    id: "pc",
    icon: "desktop",
    title: "Reparación y Mantenimiento de PC",
    image: "/imagenes/opt/instalacion-optimizada.webp",
    alt: "Mantenimiento preventivo y correctivo de computadora de escritorio en Hermosillo",
    description: "Mantenimiento preventivo y correctivo para computadoras de escritorio en oficinas, hogares y ensambles gamer. Solución a fallas de encendido, fuentes de poder y tarjetas madre.",
    badge: "Alta Demanda",
    time: "24 a 48h",
    inclusions: ["Mantenimiento físico y térmico", "Revisión de voltajes y fuente", "Garantía en mano de obra"],
    phone: "526625085372",
    waMsg: "Hola Novotec, me interesa cotizar mantenimiento o reparación para mi computadora de escritorio."
  },
  {
    id: "lentas",
    icon: "clock",
    title: "Computadoras Lentas y Optimización (Fin al Caracol)",
    image: "/imagenes/opt/programas-optimizada.webp",
    alt: "Optimización de inicio y actualización a disco sólido SSD en computadora",
    description: "¿Tu equipo tarda minutos en arrancar o se traba al trabajar? Aceleramos tu PC o laptop con cambio a disco sólido SSD de alta velocidad, ampliación de RAM y limpieza profunda del sistema.",
    badge: "Aceleración Total",
    time: "24 a 48h",
    inclusions: ["Clonación exacta sin perder archivos", "Multiplicación de velocidad real", "Garantía en disco SSD"],
    phone: "526625085372",
    waMsg: "Hola Novotec, mi computadora está sumamente lenta. Quisiera cotizar cambio a disco sólido SSD y optimización en Hermosillo."
  },
  {
    id: "antivirus",
    icon: "shield",
    title: "Eliminación de Virus y Seguridad",
    image: "/imagenes/opt/antivirus-optimizada.webp",
    alt: "Desinfección profunda de virus, troyanos y malware protegiendo archivos",
    description: "Detección y eliminación de malware, troyanos, spyware y anuncios molestos sin formatear cuando sea técnicamente posible, protegiendo tus archivos, fotos y contraseñas.",
    badge: "Protección Total",
    time: "24h",
    inclusions: ["Desinfección sin pérdida de datos", "Limpieza de navegadores secuestrados", "Asesoría preventiva"],
    phone: "526625085372",
