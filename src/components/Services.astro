    badge: "Atención Ágil",
    time: "Mismo día",
    inclusions: ["Conexión segura y supervisada", "Configuración de impresoras/software", "Sin salir de casa u oficina"],
    phone: "526625085372",
    waMsg: "Hola Novotec, quisiera solicitar soporte técnico remoto para un problema de configuración en mi equipo."
  },
  {
    id: "redes",
    icon: "network",
    title: "Redes, WiFi y Conectividad",
    image: "/imagenes/opt/redes-optimizada.webp",
