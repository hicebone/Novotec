    description: "Solución a caídas de internet, baja cobertura de señal, configuración de módems, routers, repetidores WiFi, impresoras compartidas y cableado de red.",
    badge: "Hogar y Negocio",
    time: "Agendado",
    inclusions: ["Ampliación de cobertura WiFi", "Conexión de impresoras de red", "Pruebas de estabilidad"],
    phone: "526625085372",
    waMsg: "Hola Novotec, necesito apoyo con la configuración de red WiFi o conectividad en Hermosillo."
  },
  {
    id: "software-medida",
    icon: "code",
    title: "Software a tu Medida y Automatización",
    image: "/imagenes/opt/programas-optimizada.webp",
    alt: "Desarrollo de software y aplicaciones a la medida para negocios en Hermosillo",
    description: "Desarrollo de sistemas personalizados, automatización de procesos, aplicaciones web y herramientas adaptadas a las necesidades exactas de tu comercio o negocio.",
    badge: "Personalizado",
    time: "Según proyecto",
    inclusions: ["Levantamiento de requerimientos", "Desarrollo adaptado a tu flujo", "Soporte directo dedicado"],
