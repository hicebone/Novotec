---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const resolveAsset = (path: string) => {
  if (path.startsWith('http')) return path;
  const clean = path.startsWith('/') ? path.slice(1) : path;
  return `${base}${clean}`;
};

const services = [
  {
    id: "laptops",
    icon: "laptop",
    title: "Reparación de Laptops en Hermosillo",
    image: "/imagenes/opt/reparacion-optimizada.webp",
    alt: "Técnico especialista diagnosticando y reparando una laptop en taller Hermosillo",
    description: "Diagnóstico preciso para laptops que no encienden, pantallas rotas o negras, cambio de bisagras, teclado, batería, limpieza interna y cambio de pasta térmica en todas las marcas.",
    badge: "Servicio Frecuente"
  },
  {
    id: "pc",
    icon: "desktop",
    title: "Reparación y Mantenimiento de PC",
    image: "/imagenes/opt/instalacion-optimizada.webp",
    alt: "Mantenimiento preventivo y correctivo de computadora de escritorio en Hermosillo",
    description: "Mantenimiento preventivo y correctivo para computadoras de escritorio en oficinas, hogares y ensambles gamer. Solución a fallas de encendido, fuentes de poder y tarjetas madre.",
    badge: "Alta Demanda"
  },
  {
    id: "lentas",
    icon: "clock",
    title: "Computadoras Lentas y Optimización",
    image: "/imagenes/opt/programas-optimizada.webp",
    alt: "Optimización de inicio y actualización a disco sólido SSD en computadora",
    description: "¿Tu equipo tarda minutos en arrancar o se traba al trabajar? Aceleramos tu PC o laptop con cambio a disco sólido SSD de alta velocidad, ampliación de RAM y limpieza del sistema.",
    badge: "Aceleración Total"
  },
  {
    id: "antivirus",
    icon: "shield",
    title: "Eliminación de Virus y Seguridad",
    image: "/imagenes/opt/antivirus-optimizada.webp",
    alt: "Desinfección profunda de virus, troyanos y malware protegiendo archivos",
    description: "Detección y eliminación de malware, troyanos, spyware y anuncios molestos sin formatear cuando sea técnicamente posible, protegiendo tus archivos, fotos y contraseñas.",
    badge: "Protección Total"
  },
  {
    id: "software",
    icon: "software",
    title: "Instalación de Windows y Software",
    image: "/imagenes/opt/programas-optimizada.webp",
    alt: "Instalación limpia de sistema operativo Windows y paquetería con respaldo",
    description: "Instalación y configuración limpia de Windows y programas básicos con controladores oficiales, siempre con respaldo preventivo obligatorio de tus archivos personales.",
    badge: "Respaldo Seguro"
  },
  {
    id: "recuperacion",
    icon: "database",
    title: "Recuperación de Archivos y Datos",
    image: "/imagenes/opt/recuperacion-optimizada.webp",
    alt: "Rescate de fotos y documentos en discos duros dañados o memorias USB",
    description: "Asistencia para recuperar documentos de trabajo, fotografías familiares y archivos valiosos en discos duros con fallas, memorias USB ilegibles o formateos accidentales.",
    badge: "Confidencial"
  },
  {
    id: "remoto",
    icon: "laptop",
    title: "Soporte Técnico Remoto",
    image: "/imagenes/opt/redes-optimizada.webp",
    alt: "Atención y soporte técnico remoto por internet para laptops y computadoras",
    description: "Atención rápida a distancia cuando el problema sea de configuración o software y no requiera traslado físico del equipo, ahorrándote tiempo y desplazamientos.",
    badge: "Atención Ágil"
  },
  {
    id: "redes",
    icon: "network",
    title: "Redes, WiFi y Conectividad",
    image: "/imagenes/opt/redes-optimizada.webp",
    alt: "Solución de problemas de internet y configuración de redes WiFi en Hermosillo",
    description: "Solución a caídas de internet, baja cobertura de señal, configuración de módems, routers, repetidores WiFi, impresoras compartidas y cableado de red.",
    badge: "Hogar y Negocio"
  },
  {
    id: "software-medida",
    icon: "code",
    title: "Software a tu medida",
    image: "/imagenes/opt/programas-optimizada.webp",
    alt: "Desarrollo de software y aplicaciones a la medida para negocios en Hermosillo",
    description: "Desarrollo de sistemas personalizados, automatización de procesos, aplicaciones web y herramientas adaptadas a las necesidades exactas de tu negocio.",
    badge: "Personalizado",
    whatsapp: "526861239845"
  }
];
---

<section id="servicios" class="section section--alt">
  <div class="container">
    <div class="section-header">
      <span class="section-kicker">Servicios de Soporte y Reparación</span>
      <h2 id="servicios-title" class="section-title">
        Soluciones técnicas para computadoras y laptops en Hermosillo
      </h2>
      <p class="section-description">
        Mantenimiento honesto, refacciones de calidad y explicación clara de cada procedimiento en Hermosillo.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card" aria-labelledby={`service-heading-${s.id}`}>
          <div class="service-media">
            <img
              src={resolveAsset(s.image)}
              alt={s.alt}
              class="service-img"
              width="600"
              height="338"
              loading="lazy"
              decoding="async"
            />
            <span class="service-badge">{s.badge}</span>
          </div>

          <div class="service-body">
            <div class="service-header">
              <span class="service-icon-box" aria-hidden="true">
                <Icon name={s.icon} size={24} />
              </span>
              <h3 id={`service-heading-${s.id}`} class="service-name">
                {s.title}
              </h3>
            </div>

            <p class="service-text">
              {s.description}
            </p>

            <div class="service-footer">
              <a
                href={`https://wa.me/${s.whatsapp || '526625085372'}?text=${encodeURIComponent(`Hola, me interesa cotizar el servicio de ${s.title}.`)}`}
                class="service-cta"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Cotizar por WhatsApp el servicio de ${s.title} (abre en nueva pestaña)`}
              >
                <span>Cotizar por WhatsApp</span>
                <span class="cta-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .service-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border);
  }

  .service-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: #e5effa;
    overflow: hidden;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .service-card:hover .service-img {
    transform: scale(1.03);
  }

  .service-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    background-color: rgba(7, 17, 31, 0.85);
    color: #ffffff;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
  }

  .service-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .service-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--color-accent-light);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .service-name {
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    line-height: 1.3;
    text-align: center;
  }

  .service-text {
    font-size: 0.98rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    text-align: left;
    flex-grow: 1;
  }

  .service-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    text-align: center;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.5rem;
    font-weight: var(--font-weight-bold);
    font-size: 0.95rem;
    color: var(--color-primary);
    min-height: 44px;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .service-cta:hover {
    color: var(--color-primary-hover);
    gap: 0.75rem;
  }

  .cta-arrow {
    font-size: 1.1rem;
  }

  @media (max-width: 767px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
