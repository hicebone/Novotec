---

<section id="servicios" class="section services-section">
  <div class="container">
    <div class="section-header">
      <span class="section-kicker">
        <Icon name="award" size={16} />
        <span>Servicios Profesionales de Taller</span>
      </span>
      <h2 id="servicios-title" class="section-title">
        Soluciones técnicas comprobadas para computadoras y laptops en Hermosillo
      </h2>
      <p class="section-description">
        Cada equipo es inspeccionado con rigor en nuestro taller, informándote con honestidad el diagnóstico y costo exacto antes de realizar cualquier intervención.
      </p>
    </div>

    <div class="services-sheet-grid">
      {services.map((item) => (
        <article class="service-sheet" id={`servicio-${item.id}`}>
          <div class="sheet-media">
            <img
              src={resolveAsset(item.image)}
              alt={item.alt}
              class="sheet-img"
              width="450"
              height="280"
              loading="lazy"
              decoding="async"
            />
            <span class="sheet-badge">{item.badge}</span>
          </div>

          <div class="sheet-body">
            <div class="sheet-meta">
              <span class="sheet-time">
                <Icon name="clock" size={15} />
                <span>Tiempo: {item.time}</span>
              </span>
              <span class="sheet-icon-wrap" aria-hidden="true">
                <Icon name={item.icon} size={20} />
              </span>
            </div>

            <h3 class="sheet-title">{item.title}</h3>
            <p class="sheet-desc">{item.description}</p>

            <ul class="sheet-inclusions" aria-label={`Detalles incluidos en ${item.title}`}>
              {item.inclusions.map((inc) => (
                <li>
                  <span class="inc-check" aria-hidden="true">
                    <Icon name="check" size={14} />
                  </span>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>

            <div class="sheet-actions">
              <a
                href={`https://wa.me/${item.phone}?text=${encodeURIComponent(item.waMsg)}`}
                class="btn btn-whatsapp sheet-btn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Cotizar por WhatsApp: ${item.title} (+52 ${item.phone.slice(2, 5)} ${item.phone.slice(5, 8)} ${item.phone.slice(8)}, abre en nueva pestaña)`}
              >
                <Icon name="whatsapp" size={18} />
                <span>Cotizar por WhatsApp</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--color-bg);
  }

  .services-sheet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 2rem;
  }

  .service-sheet {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .service-sheet:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .sheet-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #07111f;
  }

  .sheet-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }

  .service-sheet:hover .sheet-img {
    transform: scale(1.02);
  }

  .sheet-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    background-color: rgba(11, 15, 23, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sheet-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .sheet-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .sheet-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-copper);
    background-color: var(--color-copper-light);
    border: 1px solid var(--color-copper-border);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
  }

  .sheet-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
  }

  .sheet-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    line-height: 1.3;
    margin-bottom: 0.75rem;
    text-align: left;
  }

  .sheet-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    text-align: left;
  }

  .sheet-inclusions {
    list-style: none;
    padding: 1rem 0;
    margin: 0 0 1.5rem 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sheet-inclusions li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--color-text-main);
  }

  .inc-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-xs);
    background-color: var(--color-success-bg);
    color: var(--color-success);
    flex-shrink: 0;
  }

  .sheet-actions {
    margin-top: auto;
  }

  .sheet-btn {
    width: 100%;
  }

  @media (max-width: 600px) {
    .services-sheet-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
