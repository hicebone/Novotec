---
import Icon from './Icon.astro';
import BrandBadge from './BrandBadge.astro';
---

<footer class="site-footer" aria-label="Pie de página">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand-col">
        <div class="footer-badge-wrap">
          <BrandBadge size={40} showCaption={false} />
          <span class="footer-brand-name">Novotec Hermosillo</span>
        </div>
        <p class="footer-tagline">
          Taller formal de soporte y reparación especializado en laptops, computadoras de escritorio, optimización contra lentitud, rescate de archivos y redes en Hermosillo, Sonora. Más de 25 años de oficio técnico comprobado.
        </p>
        <div class="footer-social" aria-label="Canales oficiales de contacto y redes">
          <a
            href="tel:+526625085372"
            class="social-btn"
            aria-label="Llamar directamente al taller Novotec Hermosillo al +52 662 508 5372"
          >
            <Icon name="phone" size={18} />
          </a>
          <a
            href="https://wa.me/526625085372"
            class="social-btn social-btn--wa"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contactar a Novotec por WhatsApp al +52 662 508 5372 (abre en nueva pestaña)"
          >
            <Icon name="whatsapp" size={18} />
          </a>
          <a
            href="https://facebook.com/elnovotech"
            class="social-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Página oficial de Facebook de Novotec (abre en nueva pestaña)"
          >
            <Icon name="facebook" size={18} />
          </a>
        </div>
      </div>

      <nav class="footer-links-col" aria-label="Enlaces rápidos del sitio">
        <h3 class="footer-heading">Navegación</h3>
        <ul class="footer-nav-list">
          <li><a href="#inicio" class="footer-link">Inicio</a></li>
          <li><a href="#diagnostico" class="footer-link footer-link--highlight">Mesa de Diagnóstico</a></li>
          <li><a href="#servicios" class="footer-link">Servicios de Taller</a></li>
          <li><a href="#proceso" class="footer-link">Cómo Trabajamos</a></li>
          <li><a href="#experiencia" class="footer-link">Trayectoria y Garantía</a></li>
          <li><a href="#faq" class="footer-link">Preguntas Frecuentes</a></li>
          <li><a href="#contacto" class="footer-link">Contacto y Cotización</a></li>
        </ul>
      </nav>

      <div class="footer-hours-col">
        <h3 class="footer-heading">Horario y Taller</h3>
        <p class="footer-info-text">
          <strong>Ubicación:</strong> Hermosillo, Sonora, México
        </p>
        <p class="footer-info-text">
          <strong>Lunes a Viernes:</strong> 9:00 am - 6:00 pm<br />
          <strong>Sábados:</strong> 9:00 am - 2:00 pm
        </p>
        <p class="footer-info-text">
          <strong>Teléfono oficial:</strong> <a href="tel:+526625085372" class="footer-link footer-link--inline">+52 662 508 5372</a>
        </p>
        <p class="footer-info-text">
          <strong>Software a medida:</strong> <a href="https://wa.me/526861239845" class="footer-link footer-link--inline" target="_blank" rel="noopener noreferrer">+52 686 123 9845</a>
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; 2026 Novotec Hermosillo. Todos los derechos reservados.
      </p>
      <p class="footer-a11y-badge">
        Sitio diseñado con accesibilidad digital total (WCAG 2.2 AA). By Cuidado con el Ciego.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark-bg);
    color: var(--color-text-inverse-muted);
    border-top: 1px solid var(--color-dark-border);
    padding: 4.5rem 0 2.5rem 0;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 3.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-dark-border);
  }

  .footer-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .footer-brand-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .footer-tagline {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: var(--color-text-inverse-muted);
    max-width: 440px;
    text-align: left;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-xs);
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-dark-border);
    color: var(--color-text-inverse);
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .social-btn:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
  }

  .social-btn--wa:hover {
    background-color: var(--color-success);
    border-color: var(--color-success);
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-copper-text-dark);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    text-align: left;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    color: var(--color-text-inverse-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color var(--transition-fast);
    display: inline-block;
    padding: 0.15rem 0;
  }

  .footer-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-link--highlight {
    color: #38bdf8;
    font-weight: var(--font-weight-medium);
  }

  .footer-link--inline {
    display: inline;
    color: #ffffff;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-bold);
  }

  .footer-info-text {
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 0.85rem;
    color: var(--color-text-inverse-muted);
    text-align: left;
  }

  .footer-info-text strong {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-size: 0.88rem;
    color: var(--color-text-inverse-muted);
    margin: 0;
  }

  .footer-a11y-badge {
    font-size: 0.85rem;
    color: var(--color-copper-text-dark);
    margin: 0;
    font-weight: var(--font-weight-medium);
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
