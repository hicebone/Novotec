---
import Icon from './Icon.astro';

const faqs = [
  {
    q: "¿Cuánto tiempo tarda la reparación de una computadora o laptop?",
    a: "El tiempo promedio de diagnóstico inicial es de 24 a 48 horas. Mantenimientos preventivos, limpiezas internas, formateos o cambio de disco duro a unidad de estado sólido (SSD) frecuentemente quedan listos en 24 a 48 horas una vez autorizado el presupuesto."
  },
  {
    q: "¿Se pierden mis archivos o fotos al reparar o formatear?",
    a: "No. En Novotec realizamos un respaldo preventivo de tus documentos, fotos y datos antes de realizar cualquier intervención en el sistema operativo o disco duro. Cuidamos tu privacidad y la integridad de tu información."
  },
  {
    q: "¿Qué tipos y marcas de computadoras atienden?",
    a: "Atendemos computadoras de escritorio (PC) y laptops de todas las marcas del mercado: HP, Dell, Lenovo, ASUS, Acer, Apple Mac, así como computadoras ensambladas para diseño o computadoras gamer en Hermosillo."
  },
  {
    q: "¿Ofrecen garantía en las reparaciones?",
    a: "Sí. Todos los trabajos efectuados y las refacciones instaladas cuentan con garantía por escrito en taller para tu entera tranquilidad y respaldo."
  }
];
---

<section id="faq" class="section section--alt" aria-labelledby="faq-title">
  <div class="container faq-container">
    <div class="section-header">
      <span class="section-kicker">Preguntas Frecuentes</span>
      <h2 id="faq-title" class="section-title">
        Dudas habituales sobre nuestro servicio
      </h2>
      <p class="section-description">
        Respuestas directas sobre tiempos, respaldos y garantías para tu computadora en Hermosillo.
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((item, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary class="faq-summary">
            <span class="faq-question">{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <Icon name="chevron-down" size={20} />
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-container {
    max-width: 860px;
  }

  .faq-list {
    display: grid;
    gap: 1.25rem;
  }

  .faq-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.35rem 1.6rem;
    font-size: 1.1rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-surface-alt);
    color: var(--color-primary);
    flex-shrink: 0;
    transition: transform 200ms ease, background-color 200ms ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .faq-answer {
    padding: 0 1.6rem 1.5rem 1.6rem;
    font-size: 1.02rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 1.25rem;
  }

  .faq-answer p {
    margin: 0;
  }
</style>
