---
import Icon from './Icon.astro';
import BrandBadge from './BrandBadge.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroImgSrc = `${base}imagenes/opt/reparacion-optimizada.webp`;
---

<section id="inicio" class="hero-section">
  <div class="container hero-container">
    <!-- Columna Izquierda (60%): Propuesta de Valor, H1 único y Acciones Principales -->
    <div class="hero-content">
      <div class="hero-badge-kicker">
        <span class="badge-dot" aria-hidden="true"></span>
        <span class="badge-text">Taller Especializado en Hermosillo · 25+ Años de Oficio</span>
      </div>

      <h1 id="hero-title" class="hero-title">
        Reparación de computadoras en Hermosillo: <span class="hero-title-accent">diagnóstico honesto y solución garantizada</span>
      </h1>

      <p class="hero-description">
        En Novotec resolvemos problemas reales de laptops y PCs de escritorio: computadoras lentas que se arrastran como caracol, sobrecalentamiento, pantallas rotas o negras, virus invasivos y rescate de información valiosa. Sin tecnicismos confusos y con presupuesto por escrito antes de intervenir.
      </p>

      <div class="hero-actions">
        <a href="#diagnostico" class="btn btn-copper btn-hero">
          <Icon name="award" size={20} />
          <span>Identificar falla de mi equipo</span>
        </a>

        <a
          href="https://wa.me/526625085372?text=Hola%20Novotec%2C%20quisiera%20cotizar%20un%20servicio%20de%20reparaci%C3%B3n%20para%20mi%20computadora%20en%20Hermosillo."
          class="btn btn-whatsapp btn-hero"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cotizar por WhatsApp: Reparación de computadoras en Hermosillo (+52 662 508 5372, abre en nueva pestaña)"
        >
          <Icon name="whatsapp" size={22} />
          <span>Cotizar por WhatsApp</span>
        </a>
      </div>

      <!-- Tira de 3 certezas técnicas de taller -->
      <ul class="hero-guarantees" aria-label="Compromisos centrales de servicio">
        <li class="guarantee-item">
          <span class="guarantee-check" aria-hidden="true">
            <Icon name="check" size={16} />
          </span>
          <div>
            <strong>25+ años</strong>
            <span>en Hermosillo</span>
          </div>
        </li>

        <li class="guarantee-item">
          <span class="guarantee-check" aria-hidden="true">
            <Icon name="check" size={16} />
          </span>
          <div>
            <strong>24-48 horas</strong>
            <span>diagnóstico claro</span>
          </div>
        </li>

        <li class="guarantee-item">
          <span class="guarantee-check" aria-hidden="true">
            <Icon name="check" size={16} />
          </span>
          <div>
            <strong>Respaldo seguro</strong>
            <span>de tus archivos</span>
          </div>
        </li>
      </ul>
    </div>

    <!-- Columna Derecha (40%): Ficha de Recepción de Taller y Emblema de Autor -->
    <div class="hero-stage">
      <div class="stage-frame">
        <div class="stage-topbar">
          <span class="topbar-chip">
            <span class="topbar-dot" aria-hidden="true"></span>
            <span>Mesa de Taller Activa</span>
          </span>
          <span class="topbar-code">Hermosillo, Sonora</span>
        </div>

        <div class="stage-image-wrapper">
          <img
            src={heroImgSrc}
            alt="Técnico especialista de Novotec realizando diagnóstico y mantenimiento a una laptop en banco de trabajo"
            class="stage-img"
            width="900"
            height="600"
            fetchpriority="high"
            decoding="async"
            loading="eager"
          />
        </div>

        <!-- Ficha de Inspección y Sello Histórico del Caracol -->
        <div class="stage-footer">
          <BrandBadge size={48} showCaption={true} />
          <div class="stage-callout">
            <span class="callout-label">Especialidad Central:</span>
            <span class="callout-text">Actualización a SSD y fin a la lentitud extrema</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 5rem 0 5.5rem 0;
    background-color: var(--color-dark-bg);
    color: var(--color-text-inverse);
    border-bottom: 1px solid var(--color-dark-border);
    overflow: hidden;
  }

  /* Fondo técnico con sutil gradiente industrial */
  .hero-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 80% 20%, rgba(29, 78, 216, 0.18) 0%, transparent 60%),
                radial-gradient(circle at 10% 80%, rgba(217, 119, 6, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  /* Columna Izquierda */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-badge-kicker {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 2.5vw, 0.82rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-copper-text-dark);
    background-color: rgba(217, 119, 6, 0.15);
    border: 1px solid rgba(217, 119, 6, 0.35);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .badge-text {
    line-height: 1.4;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-copper-text-dark);
    box-shadow: 0 0 8px var(--color-copper-text-dark);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.8vw, 3.1rem);
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    line-height: 1.18;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
    text-align: left;
  }

  .hero-title-accent {
    color: var(--color-focus-inverse);
    display: block;
    font-weight: var(--font-weight-semibold);
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--color-text-inverse-muted);
    line-height: 1.65;
    margin-bottom: 2.25rem;
    max-width: 580px;
    text-align: left;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.75rem;
    width: 100%;
  }

  .btn-hero {
    min-height: 52px;
    padding: 0.9rem 1.85rem;
    font-size: 1.02rem;
  }

  .hero-guarantees {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    padding: 1.25rem 0 0 0;
    margin: 0;
    border-top: 1px solid var(--color-dark-border);
    width: 100%;
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .guarantee-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
    background-color: rgba(5, 150, 105, 0.15);
    color: var(--color-success);
    border: 1px solid rgba(5, 150, 105, 0.35);
    flex-shrink: 0;
  }

  .guarantee-item div {
    display: flex;
    flex-direction: column;
    font-size: 0.88rem;
    line-height: 1.3;
  }

  .guarantee-item strong {
    color: #ffffff;
    font-weight: var(--font-weight-bold);
  }

  .guarantee-item span {
    color: var(--color-text-inverse-muted);
    font-size: 0.8rem;
  }

  /* Columna Derecha (Ficha de Taller) */
  .hero-stage {
    position: relative;
    width: 100%;
  }

  .stage-frame {
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .stage-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background-color: var(--color-dark-surface-raised);
    border-bottom: 1px solid var(--color-dark-border);
  }

  .topbar-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #ffffff;
    font-weight: var(--font-weight-medium);
  }

  .topbar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .topbar-code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-inverse-muted);
  }

  .stage-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #07111f;
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }

  .stage-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem;
    background-color: var(--color-dark-surface);
    border-top: 1px solid var(--color-dark-border);
  }

  .stage-callout {
    display: flex;
    flex-direction: column;
    text-align: right;
  }

  .callout-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-copper);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--font-weight-bold);
  }

  .callout-text {
    font-size: 0.85rem;
    color: var(--color-text-inverse-muted);
    font-weight: var(--font-weight-medium);
    max-width: 220px;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .hero-content {
      align-items: flex-start;
    }

    .hero-guarantees {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  @media (max-width: 600px) {
    .hero-section {
      padding: 3.5rem 0 4rem 0;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn-hero {
      width: 100%;
    }

    .stage-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .stage-callout {
      text-align: left;
    }
  }
</style>
