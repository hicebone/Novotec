---
import Icon from './Icon.astro';

const steps = [
  {
    step: "01",
    tag: "Fase de Ingreso",
    title: "Recepción e Inspección en Taller",
    desc: "Revisamos tu laptop o PC en banco de trabajo para detectar la causa exacta de la falla. Diagnóstico inicial formal en 24 a 48 horas.",
    detail: "Revisión física, prueba de voltajes y registro de síntomas del equipo."
  },
  {
    step: "02",
    tag: "Fase de Presupuesto",
    title: "Dictamen Claro y Presupuesto Cerrado",
    desc: "Te llamamos o escribimos por WhatsApp explicando en palabras cotidianas la falla, la solución recomendada y el costo exacto antes de hacer cualquier trabajo.",
    detail: "Cero sorpresas: ningún trabajo se inicia sin tu autorización expresa."
  },
  {
    step: "03",
    tag: "Fase de Banco",
    title: "Respaldo Preventivo y Reparación",
    desc: "Cuidamos tu información respaldando documentos y fotos antes de intervenir el sistema. Aplicamos refacciones certificadas y ajustes con rigor técnico.",
    detail: "Protección estricta de tu privacidad y de tus archivos valiosos."
  },
  {
    step: "04",
    tag: "Fase de Control",
    title: "Pruebas de Estrés y Entrega con Garantía",
    desc: "Sometemos el equipo a pruebas térmicas y de rendimiento antes de entregártelo, respaldado siempre por tu póliza de garantía escrita.",
    detail: "Entrega formal en taller con demostración de funcionamiento."
  }
];
---

<section id="proceso" class="section process-section">
  <div class="container">
    <div class="section-header">
      <span class="section-kicker">
        <Icon name="award" size={16} />
        <span>Protocolo Formal de Taller</span>
      </span>
      <h2 id="proceso-title" class="section-title">
        Cómo cuidamos y reparamos tu equipo en 4 pasos transparentes
      </h2>
      <p class="section-description">
        Un proceso ordenado y profesional para que siempre tengas el control y la tranquilidad sobre el estado de tu computadora.
      </p>
    </div>

    <div class="timeline-container">
      <div class="timeline-track" aria-hidden="true"></div>

      <div class="timeline-list">
        {steps.map((s) => (
          <article class="timeline-item">
            <div class="timeline-node">
              <span class="timeline-step-num">{s.step}</span>
            </div>

            <div class="timeline-card">
              <div class="timeline-card-header">
                <span class="timeline-tag">{s.tag}</span>
                <span class="timeline-order">Paso {s.step}</span>
              </div>
              <h3 class="timeline-title">{s.title}</h3>
              <p class="timeline-desc">{s.desc}</p>
              <div class="timeline-footer">
                <span class="timeline-check" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
                <span class="timeline-detail">{s.detail}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .process-section {
    background-color: var(--color-surface-alt);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .timeline-container {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
  }

  .timeline-track {
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 28px;
    width: 2px;
    background: linear-gradient(180deg, var(--color-primary), var(--color-copper));
    opacity: 0.35;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .timeline-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    background-color: var(--color-dark-bg);
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 14px rgba(29, 78, 216, 0.25);
    z-index: 2;
  }

  .timeline-step-num {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: #ffffff;
  }

  .timeline-item:nth-child(2) .timeline-node {
    border-color: var(--color-copper);
    box-shadow: 0 0 14px rgba(217, 119, 6, 0.25);
  }

  .timeline-item:nth-child(2) .timeline-step-num {
    color: var(--color-copper);
  }

  .timeline-item:nth-child(4) .timeline-node {
    border-color: var(--color-success);
    box-shadow: 0 0 14px rgba(5, 150, 105, 0.25);
  }

  .timeline-item:nth-child(4) .timeline-step-num {
    color: #10b981;
  }

  .timeline-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .timeline-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .timeline-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
  }

  .timeline-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .timeline-order {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    line-height: 1.3;
    margin-bottom: 0.65rem;
    text-align: left;
  }

  .timeline-desc {
    font-size: 0.98rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    text-align: left;
  }

  .timeline-footer {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .timeline-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-xs);
    background-color: var(--color-success-bg);
    color: var(--color-success);
    flex-shrink: 0;
  }

  .timeline-detail {
    font-size: 0.88rem;
    color: var(--color-text-main);
    font-weight: var(--font-weight-medium);
  }

  @media (max-width: 600px) {
    .timeline-track {
      left: 20px;
    }

    .timeline-item {
      grid-template-columns: 42px 1fr;
      gap: 1rem;
    }

    .timeline-node {
      width: 42px;
      height: 42px;
    }

    .timeline-step-num {
      font-size: 1rem;
    }

    .timeline-card {
      padding: 1.25rem 1.25rem;
    }
  }
</style>
