---
import SkipLink from '../components/SkipLink.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  preloadLcpImage?: string;
}

const {
  title = "Reparación de Computadoras en Hermosillo | Novotec",
  description = "Reparación y mantenimiento de computadoras y laptops en Hermosillo, Sonora. Más de 25 años de experiencia. Optimización, eliminación de virus y soporte técnico.",
  canonicalUrl = "https://hicebone.github.io/Novotec/",
  ogImage = "/imagenes/opt/reparacion-optimizada.webp",
  noindex = false,
  preloadLcpImage
} = Astro.props;

const siteUrl = "https://hicebone.github.io/Novotec";
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const resolveAsset = (path: string) => {
  if (path.startsWith('http')) return path;
  const clean = path.startsWith('/') ? path.slice(1) : path;
  return `${base}${clean}`;
};

const cleanOg = ogImage.startsWith('/') ? ogImage : `/${ogImage}`;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${cleanOg}`;
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="reparacion de computadoras en hermosillo, reparacion de laptops hermosillo, servicio tecnico de computadoras hermosillo, mantenimiento de computadoras hermosillo, computadoras lentas hermosillo, eliminacion de virus en computadoras, instalacion de windows hermosillo, soporte tecnico remoto computadoras, recuperacion de datos hermosillo, reparacion de pc hermosillo, optimizacion de laptops hermosillo, novotec hermosillo" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="author" content="Novotec Hermosillo" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="theme-color" content="#07111f" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="f5d5zmPTTqx5TObgbaS3w4WriQfcrLN_uvWDIUKK-sE" />

    <!-- Geo Tags para SEO Local Hermosillo, Sonora -->
    <meta name="geo.region" content="MX-SON" />
    <meta name="geo.placename" content="Hermosillo" />
    <meta name="geo.position" content="29.072967;-110.955919" />
    <meta name="ICBM" content="29.072967, -110.955919" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Novotec Hermosillo" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="Técnico especialista reparando una computadora en taller Novotec Hermosillo" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content="Técnico reparando computadora en taller Novotec Hermosillo" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={resolveAsset("/favicon.svg")} />
    <link rel="icon" type="image/png" href={resolveAsset("/imagenes/logo.png")} />
    <link rel="apple-touch-icon" href={resolveAsset("/imagenes/logo-optimized.png")} />

    <!-- Preload opcional del recurso LCP principal -->
    {preloadLcpImage && (
      <link rel="preload" as="image" href={resolveAsset(preloadLcpImage)} type="image/webp" fetchpriority="high" />
    )}

    <!-- Datos Estructurados Schema.org -->
    <SchemaOrg siteUrl={siteUrl} />
  </head>
  <body>
    <SkipLink />
    <slot />
  </body>
</html>
